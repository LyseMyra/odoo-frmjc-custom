<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_training_controles" model="ir.actions.report">
        <field name="name">Ruban de contrôles</field>
        <field name="model">training.formation</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">training_frmjc.report_controles_template</field>
        <field name="report_file">training_frmjc.report_controles_template</field>
        <field name="binding_model_id" ref="model_training_formation"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_controles_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="formation">
                <t t-call="web.external_layout">
                    <div class="page">

                        <style>
                            @page {
                                size: A4 landscape;
                                margin: 1cm 1.2cm;
                            }

                            body {
                                font-family: Arial, Helvetica, sans-serif;
                                font-size: 7pt;
                                color: #000;
                            }

                            .rc-header {
                                text-align: center;
                                border-bottom: 2px solid #2c3e50;
                                padding-bottom: 8px;
                                margin-bottom: 10px;
                            }
                            .rc-header h1 {
                                font-size: 12pt;
                                font-weight: bold;
                                text-transform: uppercase;
                                letter-spacing: 1px;
                                margin: 0 0 2px 0;
                            }
                            .rc-header p {
                                font-size: 8pt;
                                color: #444;
                                margin: 2px 0;
                            }

                            table.rc-table {
                                border-collapse: collapse;
                                width: 100%;
                                font-size: 6.5pt;
                                table-layout: fixed;
                            }

                            table.rc-table th {
                                background-color: #2c3e50;
                                color: #fff;
                                padding: 4px 3px;
                                border: 1px solid #1a252f;
                                text-align: center;
                                font-weight: bold;
                                vertical-align: middle;
                                line-height: 1.2;
                            }
                            table.rc-table th.sub {
                                background-color: #3d566e;
                                font-size: 6pt;
                            }

                            table.rc-table td {
                                border: 1px solid #aaa;
                                padding: 3px 4px;
                                vertical-align: top;
                                line-height: 1.3;
                            }

                            .col-bloc     { width: 6%; text-align: center; font-weight: bold; }
                            .col-module   { width: 5%; }
                            .col-obj      { width: 11%; }
                            .col-cont     { width: 12%; }
                            .col-interv   { width: 7%; }
                            .col-peda     { width: 10%; }
                            .col-vof      { width: 4%; text-align: right; }
                            .col-act      { width: 10%; }
                            .col-cmd      { width: 10%; }
                            .col-vent     { width: 4%; text-align: right; }
                            .col-tot      { width: 4%; text-align: right; font-weight: bold; }
                            .col-sem      { width: 4%; text-align: center; }
                            .col-jour     { width: 5%; }
                            .col-heure    { width: 4%; text-align: right; }

                            .td-bloc {
                                background-color: #ebf0f5;
                                font-weight: bold;
                                font-size: 7pt;
                                text-align: center;
                                vertical-align: middle;
                            }
                            .td-bat {
                                background-color: #fef9e7;
                            }
                            .td-num {
                                text-align: right;
                                white-space: nowrap;
                            }
                            .td-rep-sem {
                                text-align: center;
                                white-space: nowrap;
                                color: #333;
                            }
                            .td-rep-jour {
                                white-space: nowrap;
                                color: #333;
                            }
                            .td-rep-heure {
                                text-align: right;
                                white-space: nowrap;
                            }
                            .td-empty {
                                text-align: center;
                                color: #aaa;
                            }
                            .rc-footer {
                                font-size: 6.5pt;
                                color: #666;
                                font-style: italic;
                                margin-top: 10px;
                                border-top: 1px solid #ccc;
                                padding-top: 4px;
                            }
                        </style>

                        <!-- ── En-tête ────────────────────────────────────────── -->
                        <div class="rc-header">
                            <h1>Ruban de contrôles — <t t-esc="formation.type_formation or formation.name"/></h1>
                            <t t-if="formation.specialite">
                                <p><t t-esc="formation.specialite"/></p>
                            </t>
                            <t t-if="formation.mention">
                                <p>Mention : <t t-esc="formation.mention"/></p>
                            </t>
                        </div>

                        <!-- ── Tableau ────────────────────────────────────────── -->
                        <table class="rc-table">
                            <colgroup>
                                <col class="col-bloc"/>
                                <col class="col-module"/>
                                <col class="col-obj"/>
                                <col class="col-cont"/>
                                <col class="col-interv"/>
                                <col class="col-peda"/>
                                <col class="col-vof"/>
                                <col class="col-act"/>
                                <col class="col-cmd"/>
                                <col class="col-vent"/>
                                <col class="col-tot"/>
                                <col class="col-sem"/>
                                <col class="col-jour"/>
                                <col class="col-heure"/>
                            </colgroup>
                            <thead>
                                <tr>
                                    <th rowspan="2">BLOC</th>
                                    <th rowspan="2">Module</th>
                                    <th rowspan="2">Objectifs de formation</th>
                                    <th rowspan="2">Contenus</th>
                                    <th rowspan="2">Intervenant</th>
                                    <th rowspan="2">Modalités péda</th>
                                    <th rowspan="2">Vol. OF (h)</th>
                                    <th rowspan="2">Activités en entreprise</th>
                                    <th rowspan="2">Commandes en entreprise pour MA/Tuteur</th>
                                    <th rowspan="2">Vol. ENT (h)</th>
                                    <th rowspan="2">Total (h)</th>
                                    <th colspan="3">Répartition des heures</th>
                                </tr>
                                <tr>
                                    <th class="sub">N° sem.</th>
                                    <th class="sub">Jour</th>
                                    <th class="sub">Heures</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="formation.bloc_ids.sorted('sequence')" t-as="bloc">
                                    <t t-set="is_bat" t-value="bloc.type_bloc == 'bat'"/>
                                    <!-- Nombre total de lignes pour ce bloc (pour le rowspan BLOC) -->
                                    <t t-set="bloc_total_rows" t-value="sum(max(1, len(m.repartition_ids)) for m in bloc.module_ids)"/>
                                    <t t-set="bloc_total_rows" t-value="bloc_total_rows or 1"/>

                                    <t t-foreach="bloc.module_ids.sorted('sequence')" t-as="module_r">
                                        <t t-set="reps" t-value="module_r.repartition_ids.sorted(lambda r: (r.semaine, r.jour))"/>
                                        <t t-set="nb_rep" t-value="max(1, len(reps))"/>

                                        <t t-foreach="reps or [None]" t-as="rep">
                                            <tr t-att-class="'td-bat' if is_bat else ''">

                                                <!-- Cellule BLOC : seulement sur la 1re ligne du 1er module -->
                                                <t t-if="module_r_first and rep_first">
                                                    <td class="td-bloc" t-att-rowspan="bloc_total_rows">
                                                        <t t-esc="bloc.name"/>
                                                    </td>
                                                </t>

                                                <!-- Cellules module : rowspan = nb lignes de répartition -->
                                                <t t-if="rep_first">
                                                    <td t-att-rowspan="nb_rep" style="font-weight:bold;">
                                                        <t t-esc="module_r.code or ''"/>
                                                        <t t-if="module_r.intitule">
                                                            <br/><span style="font-weight:normal;"><t t-esc="module_r.intitule"/></span>
                                                        </t>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.objectifs or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.contenus or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.intervenant_default_id.name or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.modalites_peda or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep" class="td-num">
                                                        <t t-esc="'%.0f' % (module_r.volume_of or 0)"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.activites_entreprise or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep">
                                                        <t t-esc="module_r.commandes_tuteur or ''"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep" class="td-num">
                                                        <t t-esc="'%.0f' % (module_r.volume_entreprise or 0)"/>
                                                    </td>
                                                    <td t-att-rowspan="nb_rep" class="td-num" style="font-weight:bold;">
                                                        <t t-esc="'%.0f' % (module_r.volume_total or 0)"/>
                                                    </td>
                                                </t>

                                                <!-- Répartition -->
                                                <t t-if="rep">
                                                    <td class="td-rep-sem">S<t t-esc="rep.semaine"/></td>
                                                    <td class="td-rep-jour"><t t-esc="rep.jour[:3].capitalize()"/></td>
                                                    <td class="td-rep-heure"><t t-esc="'%.0f' % rep.heures"/>h</td>
                                                </t>
                                                <t t-else="">
                                                    <td class="td-empty">—</td>
                                                    <td class="td-empty">—</td>
                                                    <td class="td-empty">—</td>
                                                </t>

                                            </tr>
                                        </t>
                                    </t>
                                </t>
                            </tbody>
                        </table>

                        <div class="rc-footer">
                            Document généré par FRMJC Bretagne · Pays de la Loire
                            — Les semaines indiquées sont des numéros de semaine de formation (S1 = première semaine de cours).
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
