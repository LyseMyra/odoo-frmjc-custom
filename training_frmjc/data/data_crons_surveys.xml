<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Cron : envoi automatique des enquêtes post-formation 6 mois (quotidien, 8h UTC) -->
    <record id="cron_envoyer_enquetes_post_6mois" model="ir.cron">
        <field name="name">Formation : Enquêtes post-formation 6 mois</field>
        <field name="model_id" ref="model_training_survey"/>
        <field name="state">code</field>
        <field name="code">model._cron_envoyer_enquetes_post_6mois()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(days=1)).strftime('%Y-%m-%d 08:00:00')"/>
        <field name="active">True</field>
    </record>

</odoo>
