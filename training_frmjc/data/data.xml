<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Séquence des dossiers d'inscription ───────────────────── -->
    <record id="seq_training_inscription" model="ir.sequence">
        <field name="name">Dossier d'inscription</field>
        <field name="code">training.inscription</field>
        <field name="prefix">INSC/%(year)s/</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- ── Cron : relances automatiques (quotidien) ──────────────── -->
    <record id="ir_cron_inscription_relance" model="ir.cron">
        <field name="name">Formation : Relances dossiers incomplets</field>
        <field name="model_id" ref="model_training_inscription"/>
        <field name="state">code</field>
        <field name="code">model.action_envoyer_relances()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <!-- ── Cron : nettoyage des OTP expirés (quotidien) ─────────── -->
    <record id="ir_cron_otp_cleanup" model="ir.cron">
        <field name="name">Formation : Nettoyage OTP expirés</field>
        <field name="model_id" ref="model_training_otp"/>
        <field name="state">code</field>
        <field name="code">model.nettoyer_expires()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

</odoo>
