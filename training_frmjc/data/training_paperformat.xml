<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Paperformat FRMJC : les rapports de convention (training_conventions_report.xml)
        utilisent web.basic_layout, sans en-tête/pied de page automatique d'Odoo
        (logo + raison sociale + footer sont gérés à la main dans les templates).
        Marges standard d'un document imprimé, pas besoin de réserver de place.
    -->
    <record id="paperformat_frmjc_a4" model="report.paperformat">
        <field name="name">FRMJC A4</field>
        <field name="default">False</field>
        <field name="format">A4</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">15</field>
        <field name="margin_right">15</field>
        <field name="header_line">False</field>
        <field name="header_spacing">0</field>
        <field name="dpi">90</field>
    </record>
</odoo>
