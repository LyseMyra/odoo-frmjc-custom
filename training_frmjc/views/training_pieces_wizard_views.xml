<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_training_pieces_wizard_form" model="ir.ui.view">
        <field name="name">training.pieces.wizard.form</field>
        <field name="model">training.pieces.wizard</field>
        <field name="arch" type="xml">
            <form string="Demande de pièces manquantes">
                <field name="inscription_id" invisible="1"/>

                <div class="alert alert-info mb-3" role="status">
                    Un email sera envoyé immédiatement au candidat avec la liste
                    des pièces manquantes et un lien vers son espace portail.
                    Le statut du dossier passera à <strong>En attente de pièces</strong>.
                </div>

                <group>
                    <field name="pieces_manquantes"
                           nolabel="1"
                           style="min-height: 120px;"
                           placeholder="- CV à jour&#10;- Copie du diplôme&#10;- Justificatif de situation professionnelle…"/>
                </group>
                <group string="Message complémentaire (optionnel)">
                    <field name="message_complementaire" nolabel="1"
                           placeholder="Informations supplémentaires…"/>
                </group>

                <footer>
                    <button name="action_envoyer"
                            string="Envoyer et mettre en attente"
                            type="object"
                            class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
