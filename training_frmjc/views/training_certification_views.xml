<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste ── -->
    <record id="view_training_certification_list" model="ir.ui.view">
        <field name="name">training.certification.list</field>
        <field name="model">training.certification</field>
        <field name="arch" type="xml">
            <list string="Certifications"
                  decoration-success="statut in ('valide','transmis')"
                  decoration-info="statut == 'convoque'"
                  decoration-warning="statut == 'resultat_saisi'"
                  decoration-danger="resultat == 'ajourne'">
                <field name="partner_id" string="Stagiaire"/>
                <field name="session_id"/>
                <field name="bloc_id"/>
                <field name="type_circuit"/>
                <field name="statut" widget="badge"/>
                <field name="resultat" widget="badge" optional="show"/>
                <field name="date_certification_a" optional="show"/>
                <field name="jury_session_id" optional="show"/>
                <field name="certificateur_id" optional="show"/>
                <button name="action_imprimer_convocation_a" string="Conv. certificateur"
                        type="object" class="btn-sm btn-outline-secondary"
                        invisible="type_circuit != 'a' or statut == 'brouillon'"/>
                <button name="action_imprimer_convocation_candidat_b" string="Conv. candidat"
                        type="object" class="btn-sm btn-outline-secondary"
                        invisible="type_circuit != 'b' or statut == 'brouillon'"/>
                <button name="action_imprimer_certificat" string="Certificat réalisation"
                        type="object" class="btn-sm btn-success"
                        invisible="statut not in ('valide','transmis') or resultat != 'admis'"/>
            </list>
        </field>
    </record>

    <!-- ── Vue formulaire ── -->
    <record id="view_training_certification_form" model="ir.ui.view">
        <field name="name">training.certification.form</field>
        <field name="model">training.certification</field>
        <field name="arch" type="xml">
            <form string="Certification">
                <header>
                    <!-- Circuit A -->
                    <button name="action_planifier_circuit_a" string="Planifier"
                            type="object" class="btn-primary"
                            invisible="type_circuit != 'a' or statut != 'brouillon'"/>
                    <button name="action_convoquer_circuit_a" string="Convoquer (envoyer email)"
                            type="object" class="btn-primary"
                            invisible="type_circuit != 'a' or statut != 'planifie'"
                            confirm="Cela enverra les convocations au stagiaire et au certificateur. Continuer ?"/>
                    <!-- Circuit B -->
                    <button name="action_planifier_circuit_b" string="Planifier"
                            type="object" class="btn-primary"
                            invisible="type_circuit != 'b' or statut != 'brouillon'"/>
                    <button name="action_convoquer_circuit_b" string="Convoquer (envoyer email)"
                            type="object" class="btn-primary"
                            invisible="type_circuit != 'b' or statut != 'planifie'"
                            confirm="Cela enverra la convocation au stagiaire. Continuer ?"/>
                    <!-- Étapes communes -->
                    <button name="action_marquer_realise" string="Marquer réalisé"
                            type="object"
                            invisible="statut != 'convoque'"/>
                    <button name="action_saisir_resultat" string="Enregistrer résultat"
                            type="object" class="btn-primary"
                            invisible="statut != 'realise'"/>
                    <button name="action_valider" string="Valider"
                            type="object" class="btn-success"
                            invisible="statut != 'resultat_saisi'"
                            confirm="Confirmer la validation du résultat ?"/>
                    <button name="action_transmettre_drajes" string="Transmettre DRAJES"
                            type="object"
                            invisible="statut != 'valide'"
                            confirm="Marquer comme transmis à la DRAJES ?"/>
                    <button name="action_remettre_brouillon" string="Remettre en brouillon"
                            type="object"
                            invisible="statut == 'transmis'"/>
                    <!-- Impressions -->
                    <button name="action_imprimer_convocation_a" string="Convocation certificateur"
                            type="object" class="btn-secondary"
                            invisible="type_circuit != 'a' or statut == 'brouillon'"/>
                    <button name="action_imprimer_convocation_candidat_b" string="Convocation candidat"
                            type="object" class="btn-secondary"
                            invisible="type_circuit != 'b' or statut == 'brouillon'"/>
                    <button name="action_imprimer_certificat" string="Certificat de réalisation"
                            type="object" class="btn-secondary"
                            invisible="statut not in ('valide','transmis') or resultat != 'admis'"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="brouillon,planifie,convoque,realise,resultat_saisi,valide,transmis"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="inscription_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="session_id" readonly="1"/>
                            <field name="formation_id" readonly="1"/>
                            <field name="bloc_id"/>
                            <field name="type_circuit"/>
                        </group>
                        <group string="Résultats" invisible="statut not in ('realise','resultat_saisi','valide','transmis')">
                            <field name="resultat"/>
                            <field name="mention"/>
                            <field name="points"/>
                            <field name="date_resultat"/>
                            <field name="valide_par_id" readonly="1"/>
                            <field name="date_validation" readonly="1"/>
                        </group>
                    </group>

                    <!-- Circuit A -->
                    <group string="Planification — Circuit A" invisible="type_circuit != 'a'">
                        <group>
                            <field name="certificateur_id"/>
                            <field name="date_certification_a"/>
                            <field name="heure_debut_a" widget="float_time"/>
                            <field name="lieu_certification_a"/>
                        </group>
                        <group>
                            <field name="convocation_a_envoyee" readonly="1"/>
                            <field name="date_convocation_a" readonly="1"/>
                        </group>
                    </group>

                    <!-- Circuit B -->
                    <group string="Jury — Circuit B" invisible="type_circuit != 'b'">
                        <group>
                            <field name="jury_session_id"/>
                            <field name="ordre_passage"/>
                            <field name="numero_commission"/>
                            <field name="heure_debut_b" widget="float_time"/>
                            <field name="heure_fin_b" widget="float_time"/>
                        </group>
                        <group>
                            <field name="convocation_b_envoyee" readonly="1"/>
                        </group>
                    </group>

                    <!-- Diplôme -->
                    <group string="Diplôme / DRAJES" invisible="statut not in ('valide','transmis')">
                        <field name="numero_diplome"/>
                        <field name="date_diplome"/>
                        <field name="date_transmission_drajes" readonly="1"/>
                    </group>

                    <notebook>
                        <page string="Observations">
                            <field name="observations" nolabel="1" placeholder="Observations du jury…"/>
                        </page>
                        <page string="Documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="type_document"/>
                                    <field name="nom"/>
                                    <field name="fichier" widget="binary" filename="fichier_filename"/>
                                    <field name="fichier_filename" column_invisible="1"/>
                                    <field name="date_depot"/>
                                </list>
                            </field>
                        </page>
                        <page string="Dépenses">
                            <field name="expense_ids">
                                <list editable="bottom">
                                    <field name="type_depense"/>
                                    <field name="description"/>
                                    <field name="montant"/>
                                    <field name="date_depense"/>
                                    <field name="statut"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Vue recherche ── -->
    <record id="view_training_certification_search" model="ir.ui.view">
        <field name="name">training.certification.search</field>
        <field name="model">training.certification</field>
        <field name="arch" type="xml">
            <search string="Certifications">
                <field name="partner_id" string="Stagiaire"/>
                <field name="session_id"/>
                <field name="bloc_id"/>
                <filter name="circuit_a" string="Circuit A"
                        domain="[('type_circuit','=','a')]"/>
                <filter name="circuit_b" string="Circuit B"
                        domain="[('type_circuit','=','b')]"/>
                <separator/>
                <filter name="a_planifier" string="À planifier"
                        domain="[('statut','=','brouillon')]"/>
                <filter name="a_convoquer" string="À convoquer"
                        domain="[('statut','=','planifie')]"/>
                <filter name="en_attente" string="Convoquées"
                        domain="[('statut','=','convoque')]"/>
                <filter name="resultat_a_saisir" string="Résultat à saisir"
                        domain="[('statut','=','realise')]"/>
                <filter name="admis" string="Admis"
                        domain="[('resultat','=','admis')]"/>
                <filter name="ajourne" string="Ajourné"
                        domain="[('resultat','=','ajourne')]"/>
                <separator/>
                <filter name="group_session" string="Par session"
                        context="{'group_by': 'session_id'}"/>
                <filter name="group_bloc" string="Par BC"
                        context="{'group_by': 'bloc_id'}"/>
                <filter name="group_statut" string="Par statut"
                        context="{'group_by': 'statut'}"/>
            </search>
        </field>
    </record>

    <!-- ── Actions ── -->
    <record id="action_training_certification" model="ir.actions.act_window">
        <field name="name">Certifications</field>
        <field name="res_model">training.certification</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_certification_search"/>
        <field name="context">{'search_default_group_session': 1}</field>
    </record>

    <record id="action_training_certification_a" model="ir.actions.act_window">
        <field name="name">Circuit A — En structure</field>
        <field name="res_model">training.certification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type_circuit','=','a')]</field>
        <field name="search_view_id" ref="view_training_certification_search"/>
    </record>

    <record id="action_training_certification_b" model="ir.actions.act_window">
        <field name="name">Circuit B — Jury OF</field>
        <field name="res_model">training.certification</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('type_circuit','=','b')]</field>
        <field name="search_view_id" ref="view_training_certification_search"/>
    </record>

</odoo>
