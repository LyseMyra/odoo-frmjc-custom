<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste ─────────────────────────────────────────────────── -->
    <record id="view_training_depense_intervenant_list" model="ir.ui.view">
        <field name="name">training.depense.intervenant.list</field>
        <field name="model">training.depense.intervenant</field>
        <field name="arch" type="xml">
            <list string="Dépenses intervenants"
                  decoration-success="statut == 'bc_cree'"
                  decoration-warning="statut == 'valide'"
                  decoration-muted="statut == 'brouillon'">
                <field name="session_id" string="Session"/>
                <field name="partner_id" string="Intervenant"/>
                <field name="date_depense"/>
                <field name="product_id" string="Produit"/>
                <field name="description"/>
                <field name="quantite"/>
                <field name="prix_unitaire"/>
                <field name="montant_total"/>
                <field name="statut" widget="badge"/>
                <field name="purchase_order_id" string="BC" optional="show"/>
                <button name="action_valider" string="Valider"
                        type="object" class="btn-sm btn-success"
                        invisible="statut != 'brouillon'"/>
            </list>
        </field>
    </record>

    <!-- ── Vue formulaire ────────────────────────────────────────────── -->
    <record id="view_training_depense_intervenant_form" model="ir.ui.view">
        <field name="name">training.depense.intervenant.form</field>
        <field name="model">training.depense.intervenant</field>
        <field name="arch" type="xml">
            <form string="Dépense intervenant">
                <header>
                    <button name="action_valider" string="Valider"
                            type="object" class="btn-primary"
                            invisible="statut != 'brouillon'"/>
                    <button name="action_remettre_brouillon" string="Remettre en brouillon"
                            type="object"
                            invisible="statut != 'valide'"/>
                    <field name="statut" widget="statusbar"
                           statusbar_visible="brouillon,valide,bc_cree"/>
                </header>
                <sheet>
                    <group>
                        <group string="Intervenant">
                            <field name="session_id"/>
                            <field name="partner_id" string="Intervenant (contact)"/>
                        </group>
                        <group string="Produit / Prestation">
                            <field name="product_id"
                                   domain="[('name', 'ilike', 'DEJEPS')]"/>
                            <field name="description"/>
                            <field name="date_depense"/>
                        </group>
                    </group>
                    <group string="Montant">
                        <group>
                            <field name="quantite"/>
                            <field name="prix_unitaire"/>
                            <field name="montant_total" readonly="1"/>
                        </group>
                        <group>
                            <field name="purchase_order_id" readonly="1"/>
                            <field name="justificatif" widget="binary"
                                   filename="justificatif_filename"/>
                            <field name="justificatif_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Vue recherche ─────────────────────────────────────────────── -->
    <record id="view_training_depense_intervenant_search" model="ir.ui.view">
        <field name="name">training.depense.intervenant.search</field>
        <field name="model">training.depense.intervenant</field>
        <field name="arch" type="xml">
            <search string="Dépenses intervenants">
                <field name="partner_id" string="Intervenant"/>
                <field name="session_id"/>
                <field name="product_id"/>
                <separator/>
                <filter name="brouillon" string="Brouillon"
                        domain="[('statut', '=', 'brouillon')]"/>
                <filter name="validees" string="Validées"
                        domain="[('statut', '=', 'valide')]"/>
                <filter name="bc_cree" string="BC créé"
                        domain="[('statut', '=', 'bc_cree')]"/>
                <separator/>
                <filter name="group_session" string="Grouper par session"
                        context="{'group_by': 'session_id'}"/>
                <filter name="group_intervenant" string="Grouper par intervenant"
                        context="{'group_by': 'partner_id'}"/>
                <filter name="group_produit" string="Grouper par produit"
                        context="{'group_by': 'product_id'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action fenêtre ────────────────────────────────────────────── -->
    <record id="action_training_depense_intervenant" model="ir.actions.act_window">
        <field name="name">Dépenses intervenants</field>
        <field name="res_model">training.depense.intervenant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_depense_intervenant_search"/>
    </record>

</odoo>
