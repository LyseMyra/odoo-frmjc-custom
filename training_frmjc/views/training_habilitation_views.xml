<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_training_habilitation_list" model="ir.ui.view">
        <field name="name">training.habilitation.list</field>
        <field name="model">training.habilitation</field>
        <field name="arch" type="xml">
            <list string="Habilitations">
                <field name="numero"/>
                <field name="type_formation"/>
                <field name="date_obtention"/>
                <field name="date_expiration"/>
                <field name="statut"/>
            </list>
        </field>
    </record>

    <record id="view_training_habilitation_form" model="ir.ui.view">
        <field name="name">training.habilitation.form</field>
        <field name="model">training.habilitation</field>
        <field name="arch" type="xml">
            <form string="Habilitation DRAJES">
                <sheet>
                    <group>
                        <field name="numero"/>
                        <field name="type_formation"/>
                        <field name="date_obtention"/>
                        <field name="date_expiration"/>
                        <field name="statut"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_training_habilitation_search" model="ir.ui.view">
        <field name="name">training.habilitation.search</field>
        <field name="model">training.habilitation</field>
        <field name="arch" type="xml">
            <search string="Habilitations">
                <field name="numero"/>
                <field name="type_formation"/>
                <filter name="valide" string="Valides"
                        domain="[('statut','=','valide')]"/>
                <filter name="expiree" string="Expirees"
                        domain="[('statut','=','expiree')]"/>
                <separator/>
                <filter name="group_type" string="Grouper par Type"
                        context="{'group_by': 'type_formation'}"/>
            </search>
        </field>
    </record>

    <record id="action_training_habilitation" model="ir.actions.act_window">
        <field name="name">Habilitations</field>
        <field name="res_model">training.habilitation</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_training_habilitation_search"/>
    </record>

</odoo>
