<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Vue liste semaines ────────────────────────────────────────── -->
    <record id="view_formateur_semaine_list" model="ir.ui.view">
        <field name="name">training.formateur.semaine.list</field>
        <field name="model">training.formateur.semaine</field>
        <field name="arch" type="xml">
            <list string="Listes de présence intervenants"
                  decoration-success="nb_signes == nb_total_dj and nb_total_dj > 0"
                  decoration-warning="nb_signes > 0 and nb_signes &lt; nb_total_dj"
                  decoration-muted="nb_total_dj == 0">
                <field name="session_id" string="Session"/>
                <field name="intervenant_id" string="Intervenant"/>
                <field name="week_start" string="Semaine du"/>
                <field name="nb_signes" string="Signées"/>
                <field name="nb_total_dj" string="Total DJ"/>
                <field name="email_envoye_le" string="Email envoyé le" optional="show"/>
                <button name="action_envoyer_email" string="Envoyer le lien"
                        type="object" icon="fa-envelope"
                        title="Envoyer le lien de la liste par email à l'intervenant"/>
            </list>
        </field>
    </record>

    <!-- ── Vue formulaire semaine ────────────────────────────────────── -->
    <record id="view_formateur_semaine_form" model="ir.ui.view">
        <field name="name">training.formateur.semaine.form</field>
        <field name="model">training.formateur.semaine</field>
        <field name="arch" type="xml">
            <form string="Liste de présence hebdomadaire">
                <header>
                    <button name="action_envoyer_email"
                            string="Envoyer le lien à l'intervenant"
                            type="object"
                            class="btn-primary"/>
                </header>
                <sheet>
                    <group>
                        <group string="Identification">
                            <field name="session_id"/>
                            <field name="intervenant_id"/>
                            <field name="week_start"/>
                        </group>
                        <group string="Suivi">
                            <field name="email_envoye_le" readonly="1"/>
                            <field name="nb_signes" readonly="1"/>
                            <field name="nb_total_dj" readonly="1"/>
                        </group>
                    </group>

                    <field name="demi_journee_ids" nolabel="1">
                        <list string="Demi-journées"
                              decoration-success="statut == 'signe'"
                              decoration-muted="statut == 'en_attente'">
                            <field name="date"/>
                            <field name="demi_journee" string="Demi-journée"/>
                            <field name="statut" widget="badge"/>
                            <field name="signe_le" string="Signé le" optional="show"/>
                            <button name="action_telecharger_feuille"
                                    string="Télécharger la feuille"
                                    type="object"
                                    icon="fa-download"
                                    invisible="statut != 'signe'"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ── Vue recherche ─────────────────────────────────────────────── -->
    <record id="view_formateur_semaine_search" model="ir.ui.view">
        <field name="name">training.formateur.semaine.search</field>
        <field name="model">training.formateur.semaine</field>
        <field name="arch" type="xml">
            <search string="Listes de présence">
                <field name="session_id"/>
                <field name="intervenant_id"/>
                <separator/>
                <filter name="non_envoyes" string="Email non envoyé"
                        domain="[('email_envoye_le', '=', False)]"/>
                <separator/>
                <filter name="group_session" string="Grouper par session"
                        context="{'group_by': 'session_id'}"/>
                <filter name="group_week" string="Grouper par semaine"
                        context="{'group_by': 'week_start'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ────────────────────────────────────────────────────── -->
    <record id="action_formateur_semaine" model="ir.actions.act_window">
        <field name="name">Listes de présence intervenants</field>
        <field name="res_model">training.formateur.semaine</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_formateur_semaine_search"/>
    </record>

</odoo>
