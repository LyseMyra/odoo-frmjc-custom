<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobility_import_fiche_wizard_form" model="ir.ui.view">
        <field name="name">mobility.import.fiche.wizard.form</field>
        <field name="model">mobility.import.fiche.wizard</field>
        <field name="arch" type="xml">
            <form string="Fiche de renseignement (Excel)">
                <group>
                    <field name="mobility_id" readonly="1"/>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_telecharger_modele" string="Télécharger le modèle"
                            type="object"/>
                    <button name="action_importer" string="Importer" type="object"
                            class="oe_highlight"/>
                    <button string="Fermer" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accroché au menu "⚙ Actions" de la fiche Mobilité (une mobilité à
         la fois — le fichier est individuel, pas un import en masse). -->
    <record id="action_mobility_import_fiche" model="ir.actions.act_window">
        <field name="name">Fiche de renseignement (Excel)</field>
        <field name="res_model">mobility.import.fiche.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mobility_mobility"/>
        <field name="binding_view_types">form</field>
    </record>

</odoo>
