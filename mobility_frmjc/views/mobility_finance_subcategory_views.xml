<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobility_finance_subcategory_list" model="ir.ui.view">
        <field name="name">mobility.finance.subcategory.list</field>
        <field name="model">mobility.finance.subcategory</field>
        <field name="arch" type="xml">
            <list string="Sous-catégories financières">
                <field name="categorie"/>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="code"/>
                <field name="compte_comptable"/>
                <field name="nature_defaut"/>
                <field name="calculable"/>
            </list>
        </field>
    </record>

    <record id="view_mobility_finance_subcategory_form" model="ir.ui.view">
        <field name="name">mobility.finance.subcategory.form</field>
        <field name="model">mobility.finance.subcategory</field>
        <field name="arch" type="xml">
            <form string="Sous-catégorie financière">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="categorie"/>
                            <field name="sequence"/>
                        </group>
                        <group>
                            <field name="compte_comptable"/>
                            <field name="nature_defaut"/>
                            <field name="calculable"/>
                            <field name="type_calcul" invisible="not calculable"/>
                        </group>
                    </group>
                    <group string="Produit (facturation / bons de commande)">
                        <field name="product_categ_id"/>
                        <field name="product_id" readonly="1"
                               help="Créé automatiquement au premier besoin (facture/BC) — un seul produit par sous-catégorie."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mobility_finance_subcategory" model="ir.actions.act_window">
        <field name="name">Sous-catégories financières</field>
        <field name="res_model">mobility.finance.subcategory</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
