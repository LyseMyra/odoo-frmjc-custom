<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Kanban (pipeline) ──────────────────────────────────────── -->
    <record id="view_mobility_mobility_kanban" model="ir.ui.view">
        <field name="name">mobility.mobility.kanban</field>
        <field name="model">mobility.mobility</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" quick_create="false" class="o_kanban_mobility">
                <field name="name"/>
                <field name="participant_id"/>
                <field name="country_id"/>
                <field name="programme"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <strong><field name="participant_id"/></strong>
                            <div><field name="country_id"/></div>
                            <div><field name="programme"/></div>
                            <div>
                                <field name="start_date"/> → <field name="end_date"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ── Liste ──────────────────────────────────────────────────── -->
    <record id="view_mobility_mobility_list" model="ir.ui.view">
        <field name="name">mobility.mobility.list</field>
        <field name="model">mobility.mobility</field>
        <field name="arch" type="xml">
            <list string="Mobilités" decoration-danger="status in ('annule', 'abandon')">
                <field name="name"/>
                <field name="participant_id"/>
                <field name="programme"/>
                <field name="mobility_direction"/>
                <field name="country_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- ── Formulaire ─────────────────────────────────────────────── -->
    <record id="view_mobility_mobility_form" model="ir.ui.view">
        <field name="name">mobility.mobility.form</field>
        <field name="model">mobility.mobility</field>
        <field name="arch" type="xml">
            <form string="Mobilité">
                <header>
                    <button name="action_marquer_formalites" string="Formalités en cours"
                            type="object" class="oe_highlight"
                            invisible="status != 'selectionne'"/>
                    <button name="action_marquer_placement" string="Placement en cours"
                            type="object" class="oe_highlight"
                            invisible="status != 'formalites'"/>
                    <button name="action_marquer_mission" string="En mission"
                            type="object" class="oe_highlight"
                            invisible="status != 'placement'"/>
                    <button name="action_marquer_termine" string="Terminé"
                            type="object" class="oe_highlight"
                            invisible="status != 'mission'"/>
                    <button name="action_marquer_suivi_post" string="Suivi post-mission"
                            type="object" class="oe_highlight"
                            invisible="status != 'termine'"/>
                    <button name="action_valider_fiche_renseignement"
                            string="Valider la fiche de renseignement"
                            type="object" class="oe_highlight"
                            invisible="not fiche_renseignement_soumise_le or fiche_renseignement_validee"/>
                    <button name="action_ouvrir_fiche_renseignement"
                            string="Ouvrir le lien du formulaire public"
                            type="object"/>
                    <button name="action_marquer_annule" string="Annuler la mobilité"
                            type="object" confirm="Confirmer l'annulation de cette mobilité ?"
                            invisible="status in ('mission', 'termine', 'suivi_post', 'annule', 'abandon')"/>
                    <button name="action_marquer_abandon" string="Déclarer un abandon"
                            type="object" confirm="Confirmer l'abandon en cours de mission ?"
                            invisible="status != 'mission'"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="selectionne,formalites,placement,mission,termine,suivi_post"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-warning" role="alert"
                         invisible="not eligibility_alerts">
                        <field name="eligibility_alerts" readonly="1" nolabel="1"/>
                    </div>
                    <div class="alert alert-danger" role="alert"
                         invisible="status not in ('annule', 'abandon')">
                        <strong>
                            <field name="status" readonly="1" nolabel="1"/> le
                            <field name="date_sortie" readonly="1" nolabel="1"/> —
                        </strong>
                        <field name="motif_sortie" readonly="1" nolabel="1"/>
                    </div>
                    <notebook>
                        <!-- Identification/classification : saisies par le
                             secrétariat. Lieu et Offre : en grande partie
                             renseignées par la structure d'accueil via le
                             formulaire public — les dates réelles de mission
                             (Lieu &amp; dates) restent à part, connues plus
                             tard, une fois l'arrivée du volontaire confirmée. -->
                        <page string="Informations" name="informations">
                            <group>
                                <group string="Identification">
                                    <field name="prn"/>
                                    <field name="reference_projet"/>
                                    <field name="action_cle"/>
                                    <field name="user_id"/>
                                    <field name="company_id" groups="base.group_multi_company"/>
                                </group>
                                <group string="Classification">
                                    <field name="programme"/>
                                    <field name="mobility_direction"/>
                                    <field name="mobility_duration"/>
                                    <field name="volunteering_type"/>
                                    <field name="role_consortium"/>
                                </group>
                            </group>
                            <group>
                                <group string="Lieu &amp; dates réelles de mission">
                                    <field name="country_id"/>
                                    <field name="department_id"
                                           domain="[('country_id', '=', country_id)]"/>
                                    <field name="city"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="duree_jours"/>
                                </group>
                                <group string="Offre">
                                    <field name="offer_code"/>
                                    <field name="titre_offre"/>
                                    <field name="date_publication_offre"/>
                                    <field name="date_selection_offre"/>
                                    <field name="date_debut_proposee"/>
                                    <field name="date_fin_proposee"/>
                                    <field name="statut_offre"/>
                                    <field name="source_offre"/>
                                </group>
                            </group>
                            <group string="Mission">
                                <field name="heures_semaine"/>
                                <field name="langue_travail"/>
                            </group>

                            <!-- Avenants : historique des prolongations/réductions
                                 de la mission. Appliquer un avenant met à jour
                                 la date de fin ci-dessus — les lignes financières
                                 calculables de l'onglet Finance se resynchronisent
                                 alors automatiquement (nb_jours/montant prévu
                                 dépendent déjà de la date de fin de la mobilité). -->
                            <group string="Avenants (prolongation / réduction)">
                                <field name="avenant_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="date"/>
                                        <field name="type_avenant"/>
                                        <field name="ancienne_date_fin" readonly="1"/>
                                        <field name="nouvelle_date_fin"/>
                                        <field name="motif"/>
                                        <field name="document_id"/>
                                        <field name="state" widget="badge"/>
                                        <button name="action_appliquer" string="Appliquer"
                                                type="object" icon="fa-check"
                                                title="Applique la nouvelle date de fin sur la mobilité"
                                                invisible="state == 'applique'"/>
                                    </list>
                                </field>
                            </group>

                            <!-- Sortie de parcours : à renseigner AVANT de cliquer
                                 sur « Annuler la mobilité » / « Déclarer un abandon »
                                 (boutons d'en-tête) — ces actions exigent un motif. -->
                            <group string="Sortie du parcours (annulation / abandon)">
                                <field name="date_sortie"/>
                                <field name="motif_sortie"/>
                            </group>
                        </page>

                        <!-- Tout ce qui concerne la personne du volontaire :
                             identité, documents, contact d'urgence, plus le
                             suivi du dépôt de la fiche et la déclaration qui
                             l'accompagne. -->
                        <page string="Volontaire" name="volontaire">
                            <group>
                                <group string="Identité">
                                    <field name="participant_id"/>
                                    <field name="participant_prenom"/>
                                    <field name="participant_nom"/>
                                    <field name="email"/>
                                    <field name="telephone"/>
                                    <field name="sexe"/>
                                    <field name="date_naissance"/>
                                    <field name="age"/>
                                    <field name="nationalite_id"/>
                                    <field name="pays_residence_id"/>
                                    <field name="ville_residence"/>
                                    <field name="jeune"/>
                                </group>
                                <group string="Documents &amp; besoins">
                                    <field name="id_document_numero"/>
                                    <field name="id_document_validite"/>
                                    <field name="besoins_particuliers"/>
                                </group>
                            </group>
                            <group string="Contact d'urgence">
                                <field name="contact_urgence_nom"/>
                                <field name="contact_urgence_lien"/>
                                <field name="contact_urgence_adresse"/>
                                <field name="contact_urgence_telephone"/>
                                <field name="contact_urgence_email"/>
                            </group>
                            <group>
                                <group string="Suivi du formulaire public">
                                    <field name="portal_token" readonly="1"/>
                                    <field name="fiche_renseignement_soumise_le" readonly="1"/>
                                    <field name="fiche_renseignement_validee" readonly="1"/>
                                </group>
                                <group string="Déclaration sur l'honneur">
                                    <field name="declaration_acceptee"/>
                                    <field name="date_declaration"/>
                                    <field name="lieu_declaration"/>
                                    <field name="signature_nom"/>
                                </group>
                            </group>
                        </page>

                        <!-- Toutes les structures : liens réels (Many2one) et
                             saisie brute du formulaire regroupés par rôle,
                             plutôt que séparés dans des onglets différents. -->
                        <page string="Structures" name="structures">
                            <group string="Référentiels">
                                <field name="grant_id"/>
                                <field name="habilitation_id"/>
                                <field name="lead_partner_id"/>
                                <field name="activity_id"/>
                            </group>
                            <group>
                                <group string="Structure d'envoi">
                                    <field name="sending_partner_id"/>
                                    <field name="sending_org_nom"/>
                                    <field name="sending_org_oid_saisi"/>
                                    <field name="sending_org_nom_legal"/>
                                    <field name="sending_org_adresse"/>
                                    <field name="sending_org_type_organisme"/>
                                    <field name="sending_org_email"/>
                                    <field name="sending_org_telephone"/>
                                    <field name="sending_contact_nom"/>
                                    <field name="sending_contact_email"/>
                                    <field name="sending_contact_telephone"/>
                                </group>
                                <group string="Structure d'accueil"
                                       invisible="mobility_direction == 'envoi'">
                                    <field name="hosting_partner_id"/>
                                    <field name="hosting_org_nom"/>
                                    <field name="hosting_org_oid_saisi"/>
                                    <field name="hosting_org_nom_legal"/>
                                    <field name="hosting_org_adresse"/>
                                    <field name="hosting_org_type_organisme"/>
                                    <field name="hosting_org_email"/>
                                    <field name="hosting_org_telephone"/>
                                    <field name="hosting_contact_nom"/>
                                    <field name="hosting_contact_email"/>
                                    <field name="hosting_contact_telephone"/>
                                </group>
                            </group>
                            <group>
                                <group string="Autres structures">
                                    <field name="support_partner_id"
                                           invisible="mobility_direction == 'accueil'"/>
                                    <field name="housing_partner_id"/>
                                    <field name="tutor_partner_id"/>
                                </group>
                                <group string="Convention de volontariat">
                                    <field name="convention_numero"/>
                                    <field name="convention_date"/>
                                    <field name="convention_document_id"/>
                                </group>
                            </group>
                        </page>

                        <!-- Ce qui reste une fois volontaire et structures
                             sortis : logistique du déplacement et rapport
                             de mission. -->
                        <page string="Logistique &amp; rapport" name="logistique">
                            <group>
                                <group string="Soutien linguistique">
                                    <field name="soutien_linguistique_type"/>
                                </group>
                                <group string="Force majeure">
                                    <field name="force_majeure"/>
                                    <field name="force_majeure_explication"
                                           invisible="not force_majeure"/>
                                </group>
                            </group>
                            <group string="Voyage">
                                <field name="transport_principal"/>
                                <field name="voyage_vert"/>
                                <field name="tranche_kilometrique"/>
                                <field name="distance_reelle"/>
                            </group>
                            <group string="Rapport participant">
                                <field name="rapport_demande_le"/>
                                <field name="rapport_recu_le"/>
                            </group>
                        </page>

                        <page string="Suivi" name="suivi">
                            <group>
                                <group string="Accompagnement">
                                    <field name="frequence_suivi"/>
                                    <field name="mode_suivi"/>
                                    <field name="date_dernier_entretien"/>
                                    <field name="date_prochain_entretien"/>
                                </group>
                                <group string="Suivi pédagogique">
                                    <field name="evaluation_intermediaire"/>
                                    <field name="evaluation_finale"/>
                                </group>
                            </group>
                            <group string="Observations">
                                <field name="observations_suivi" nolabel="1"/>
                            </group>
                            <group string="Objectifs">
                                <field name="objectifs_pedagogiques"/>
                                <field name="objectifs_atteints"/>
                                <field name="points_forts"/>
                                <field name="axes_amelioration"/>
                            </group>
                        </page>

                        <page string="Documents" name="documents">
                            <field name="document_ids">
                                <list editable="bottom">
                                    <field name="document_type"/>
                                    <field name="upload_date"/>
                                    <field name="emis_par"/>
                                    <field name="statut"/>
                                    <field name="attachment" filename="attachment_filename"/>
                                    <field name="attachment_filename" column_invisible="1"/>
                                </list>
                            </field>
                        </page>

                        <page string="Finance" name="finance">
                            <field name="finance_line_ids">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="subcategory_id"/>
                                    <field name="subcategory_calculable" column_invisible="1"/>
                                    <field name="periode_du" readonly="subcategory_calculable"/>
                                    <field name="periode_au" readonly="subcategory_calculable"/>
                                    <field name="nb_jours"/>
                                    <field name="montant_journalier"/>
                                    <field name="montant_prevu"/>
                                    <field name="montant_realise"/>
                                    <field name="ecart"/>
                                    <field name="statut_paiement"/>
                                    <field name="source_financement"/>
                                    <field name="statut_validation"
                                           invisible="nature not in ('recette', 'depense')"/>
                                    <button name="action_calculer" string="Calculer"
                                            type="object" icon="fa-calculator"
                                            title="Recalculer depuis le barème"
                                            invisible="not subcategory_calculable"/>
                                    <button name="action_valider" string="Valider"
                                            type="object" icon="fa-check"
                                            title="Valider avant de générer un document"
                                            invisible="statut_validation != 'brouillon' or nature not in ('recette', 'depense')"/>
                                    <button name="action_generer_document" string="Générer"
                                            type="object" icon="fa-file-text-o"
                                            title="Générer la facture / le bon de commande"
                                            invisible="statut_validation != 'validee'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- ── Recherche ──────────────────────────────────────────────── -->
    <record id="view_mobility_mobility_search" model="ir.ui.view">
        <field name="name">mobility.mobility.search</field>
        <field name="model">mobility.mobility</field>
        <field name="arch" type="xml">
            <search string="Mobilités">
                <field name="name"/>
                <field name="participant_id"/>
                <field name="prn"/>
                <field name="programme"/>
                <field name="country_id"/>
                <filter name="accueil" string="Accueil"
                        domain="[('mobility_direction', '=', 'accueil')]"/>
                <filter name="envoi" string="Envoi"
                        domain="[('mobility_direction', '=', 'envoi')]"/>
                <separator/>
                <filter name="en_cours" string="En cours (mission)"
                        domain="[('status', '=', 'mission')]"/>
                <filter name="sorties" string="Annulées / Abandons"
                        domain="[('status', 'in', ('annule', 'abandon'))]"/>
                <separator/>
                <filter name="group_status" string="Grouper par statut"
                        context="{'group_by': 'status'}"/>
                <filter name="group_programme" string="Grouper par programme"
                        context="{'group_by': 'programme'}"/>
            </search>
        </field>
    </record>

    <!-- ── Action ─────────────────────────────────────────────────── -->
    <record id="action_mobility_mobility" model="ir.actions.act_window">
        <field name="name">Mobilités</field>
        <field name="res_model">mobility.mobility</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_mobility_mobility_search"/>
        <field name="context">{'search_default_group_status': 0}</field>
    </record>

</odoo>
