<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobility_import_bm_wizard_form" model="ir.ui.view">
        <field name="name">mobility.import.bm.wizard.form</field>
        <field name="model">mobility.import.bm.wizard</field>
        <field name="arch" type="xml">
            <form string="Importer BM">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_importer" string="Importer" type="object" class="oe_highlight"/>
                    <button string="Annuler" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Accroché au menu "⚙ Actions" de la liste Mobilités — même
         emplacement que "Exporter BM", pas un menu dédié. -->
    <record id="action_mobility_import_bm" model="ir.actions.act_window">
        <field name="name">Importer BM</field>
        <field name="res_model">mobility.import.bm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_mobility_mobility"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>
