<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobility_document_list" model="ir.ui.view">
        <field name="name">mobility.document.list</field>
        <field name="model">mobility.document</field>
        <field name="arch" type="xml">
            <list string="Documents">
                <field name="document_type"/>
                <field name="mobility_id"/>
                <field name="participant_id"/>
                <field name="upload_date"/>
                <field name="emis_par"/>
                <field name="statut"/>
            </list>
        </field>
    </record>

    <record id="view_mobility_document_form" model="ir.ui.view">
        <field name="name">mobility.document.form</field>
        <field name="model">mobility.document</field>
        <field name="arch" type="xml">
            <form string="Document">
                <sheet>
                    <group>
                        <group>
                            <field name="document_type"/>
                            <field name="mobility_id"/>
                            <field name="activity_id"/>
                            <field name="participant_id"/>
                            <field name="statut"/>
                        </group>
                        <group>
                            <field name="upload_date"/>
                            <field name="emis_par"/>
                        </group>
                    </group>
                    <group string="Fichier">
                        <field name="attachment" filename="attachment_filename"/>
                        <field name="attachment_filename" invisible="1"/>
                    </group>
                    <group string="Remarques">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobility_document_search" model="ir.ui.view">
        <field name="name">mobility.document.search</field>
        <field name="model">mobility.document</field>
        <field name="arch" type="xml">
            <search string="Documents">
                <field name="mobility_id"/>
                <field name="participant_id"/>
                <field name="document_type"/>
                <filter name="a_emettre" string="À émettre"
                        domain="[('statut','=','a_emettre')]"/>
                <filter name="a_remettre" string="À remettre"
                        domain="[('statut','=','a_remettre')]"/>
                <separator/>
                <filter name="group_type" string="Grouper par type"
                        context="{'group_by': 'document_type'}"/>
                <filter name="group_statut" string="Grouper par statut"
                        context="{'group_by': 'statut'}"/>
            </search>
        </field>
    </record>

    <record id="action_mobility_document" model="ir.actions.act_window">
        <field name="name">Documents</field>
        <field name="res_model">mobility.document</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobility_document_search"/>
    </record>

</odoo>
