<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mobility_grant_list" model="ir.ui.view">
        <field name="name">mobility.grant.list</field>
        <field name="model">mobility.grant</field>
        <field name="arch" type="xml">
            <list string="Conventions de subvention">
                <field name="numero_convention"/>
                <field name="programme"/>
                <field name="date_debut"/>
                <field name="date_fin"/>
                <field name="nb_mobilities"/>
            </list>
        </field>
    </record>

    <record id="view_mobility_grant_form" model="ir.ui.view">
        <field name="name">mobility.grant.form</field>
        <field name="model">mobility.grant</field>
        <field name="arch" type="xml">
            <form string="Convention de subvention">
                <sheet>
                    <group>
                        <group>
                            <field name="numero_convention"/>
                            <field name="programme"/>
                        </group>
                        <group>
                            <field name="date_debut"/>
                            <field name="date_fin"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Mobilités rattachées" name="mobilities">
                            <field name="mobility_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="participant_id"/>
                                    <field name="mobility_direction"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_mobility_grant_search" model="ir.ui.view">
        <field name="name">mobility.grant.search</field>
        <field name="model">mobility.grant</field>
        <field name="arch" type="xml">
            <search string="Conventions de subvention">
                <field name="numero_convention"/>
                <field name="programme"/>
                <filter name="group_programme" string="Grouper par programme"
                        context="{'group_by': 'programme'}"/>
            </search>
        </field>
    </record>

    <record id="action_mobility_grant" model="ir.actions.act_window">
        <field name="name">Conventions de subvention</field>
        <field name="res_model">mobility.grant</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_mobility_grant_search"/>
    </record>

</odoo>
